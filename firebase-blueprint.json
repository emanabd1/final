{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["job-seeker", "employer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "emailVerified": { "type": "boolean" }
      },
      "required": ["uid", "email", "firstName", "lastName", "role", "createdAt"]
    },
    "Job": {
      "title": "Job",
      "description": "Job posting information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "companyLogo": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string", "enum": ["Full-time", "Part-time", "Contract", "Internship", "Volunteer"] },
        "remote": { "type": "boolean" },
        "salaryRange": { "type": "string" },
        "description": { "type": "string" },
        "responsibilities": { "type": "array", "items": { "type": "string" } },
        "experienceLevel": { "type": "string" },
        "postedAt": { "type": "string", "format": "date-time" },
        "applicantsCount": { "type": "integer" }
      },
      "required": ["title", "company", "description"]
    },
    "SavedJob": {
      "title": "SavedJob",
      "description": "A job saved by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "company": { "type": "string" },
        "salaryRange": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "jobId"]
    },
    "Application": {
      "title": "Application",
      "description": "A job application",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "interviewing", "rejected", "accepted"] },
        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "jobId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job postings"
    },
    "/users/{userId}/savedJobs/{jobId}": {
      "schema": "SavedJob",
      "description": "Jobs saved by a specific user"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Job applications"
    }
  }
}
